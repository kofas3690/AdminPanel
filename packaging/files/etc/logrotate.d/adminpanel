/opt/adminpanel/data/audit.log {
    weekly
    rotate 12
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    sharedscripts
    prerotate
        chattr -a /opt/adminpanel/data/audit.log 2>/dev/null || true
    endscript
    postrotate
        chattr +a /opt/adminpanel/data/audit.log 2>/dev/null || true
    endscript
    create 0600 adminpanel adminpanel
}
