#!/bin/bash
# adminpanel-setup: first-run setup and maintenance for the admin panel.
#   sudo adminpanel-setup                          everything, in order
#   sudo adminpanel-setup tls [--port N] [--regen] certificate and web server site
#   sudo adminpanel-setup ssh                      pin this machine's SSH host key
#   sudo adminpanel-setup ssh-local                allow password sign-in over SSH from this machine only
#   sudo adminpanel-setup ssh-restrict GROUP|off   limit that password sign-in to members of GROUP (off: everyone)
#   sudo adminpanel-setup user                     create or reset a panel administrator
#   sudo adminpanel-setup 2fa                      set up two-step verification
#   sudo adminpanel-setup remote-key               show this panel's key for managing other machines
#   sudo adminpanel-setup remote-enable 'KEY'      (on the OTHER machine) let that key run the bridge, nothing else
#   sudo adminpanel-setup remote-disable           (on the OTHER machine) undo remote-enable
#   sudo adminpanel-setup add-host NAME ADDRESS [PORT] [--fingerprint SHA256:...]   list another machine
#   sudo adminpanel-setup remove-host NAME         remove a machine from the list
#   sudo adminpanel-setup list-hosts               show the listed machines
set -euo pipefail

APP=/opt/adminpanel
PY="$APP/.venv/bin/python"
SHARE=/usr/share/adminpanel
CERT=/etc/ssl/certs/adminpanel.crt
KEY=/etc/ssl/private/adminpanel.key
SITE_AV=/etc/nginx/sites-available/adminpanel.conf
SITE_EN=/etc/nginx/sites-enabled/adminpanel.conf
SNIP=/etc/nginx/snippets
STATE=/var/lib/adminpanel
DEFAULT_PORT=8443
CREATED=0

say()  { printf '\n== %s\n' "$*"; }
warn() { printf 'WARNING: %s\n' "$*" >&2; }
die()  { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "run this with sudo"
[ -x "$PY" ] || die "the panel's Python environment is missing. Reinstall the package."

step_ssh() {
    say "Pinning this machine's SSH host key (used by the Terminal and File manager)"
    if [ ! -f /etc/ssh/ssh_host_ed25519_key.pub ] && command -v ssh-keygen >/dev/null 2>&1; then
        ssh-keygen -A >/dev/null 2>&1 || true
    fi
    if [ -f /etc/ssh/ssh_host_ed25519_key.pub ]; then
        # Kept in the root-owned state folder: the panel can read the pin but cannot change it.
        install -d -m 755 "$STATE"
        printf '127.0.0.1 %s\n' "$(cut -d' ' -f1,2 /etc/ssh/ssh_host_ed25519_key.pub)" > "$STATE/ssh_known_hosts"
        chown root:adminpanel "$STATE/ssh_known_hosts"
        chmod 640 "$STATE/ssh_known_hosts"
        rm -f "$APP/ssh_known_hosts"        # the old location, writable by the panel
        echo "done"
    else
        warn "no SSH host key found. The Terminal and File manager will not work (sudo apt install openssh-server, then run: adminpanel-setup ssh)"
    fi
    if ! systemctl is-active --quiet ssh 2>/dev/null && ! systemctl is-active --quiet sshd 2>/dev/null; then
        warn "the SSH server is not running. The Terminal and File manager need it (sudo apt install openssh-server)"
    fi
}

step_ssh_local() {
    say "Password sign-in over SSH from this machine only"
    local sshd=/usr/sbin/sshd eff remote f=/etc/ssh/sshd_config.d/60-adminpanel-localhost.conf
    [ -x "$sshd" ] || { warn "no SSH server is installed (sudo apt install openssh-server)"; return 0; }
    if grep -q '^Match Address .* Group ' "$f" 2>/dev/null; then
        echo "already set up and limited to a group (see: sudo adminpanel-setup ssh-restrict)"; return 0
    fi
    eff=$($sshd -T -C user=root,host=localhost,addr=127.0.0.1,laddr=127.0.0.1,lport=22 2>/dev/null | awk '$1=="passwordauthentication"{print $2}')
    if [ "$eff" = "yes" ]; then echo "already allowed for connections from this machine"; return 0; fi
    [ -d /etc/ssh/sshd_config.d ] || die "this SSH server has no sshd_config.d folder. Add this to /etc/ssh/sshd_config by hand: Match Address 127.0.0.1,::1 / PasswordAuthentication yes / Match all"
    cat > "$f" <<EOF
# Added by adminpanel-setup. Allows the panel Terminal and File manager to sign in from this machine only.
Match Address 127.0.0.1,::1
    PasswordAuthentication yes
Match all
EOF
    chmod 644 "$f"
    chk=$(mktemp)
    if ! $sshd -t 2>"$chk"; then
        rm -f "$f"; cat "$chk" >&2; rm -f "$chk"
        die "the SSH server rejected the change, so it was removed"
    fi
    rm -f "$chk"
    systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
    eff=$($sshd -T -C user=root,host=localhost,addr=127.0.0.1,laddr=127.0.0.1,lport=22 2>/dev/null | awk '$1=="passwordauthentication"{print $2}')
    remote=$($sshd -T -C user=root,host=example,addr=192.0.2.10,laddr=192.0.2.1,lport=22 2>/dev/null | awk '$1=="passwordauthentication"{print $2}')
    echo "password sign-in from this machine: ${eff:-unknown}; from other machines: ${remote:-unknown}"
    echo "Linux accounts still need a password to use these tools (for example: sudo passwd YOURNAME)."
}

step_ssh_restrict() {
    local grp="${1:-}" sshd=/usr/sbin/sshd f=/etc/ssh/sshd_config.d/60-adminpanel-localhost.conf bak chk
    [ -n "$grp" ] || die "usage: adminpanel-setup ssh-restrict GROUP   (or: off)"
    [ -x "$sshd" ] || die "no SSH server is installed (sudo apt install openssh-server)"
    [ -f "$f" ] || die "run this first: sudo adminpanel-setup ssh-local"
    bak=$(mktemp)
    cp "$f" "$bak"
    if [ "$grp" = off ]; then
        cat > "$f" <<EOF
# Added by adminpanel-setup. Allows the panel Terminal and File manager to sign in from this machine only.
Match Address 127.0.0.1,::1
    PasswordAuthentication yes
Match all
EOF
    else
        case "$grp" in ''|[!a-z_]*|*[!a-z0-9_-]*) rm -f "$bak"; die "the group name must be lower case letters, digits, _ and -" ;; esac
        [ "${#grp}" -le 32 ] || { rm -f "$bak"; die "the group name is too long"; }
        getent group "$grp" >/dev/null || addgroup --system "$grp" >/dev/null
        cat > "$f" <<EOF
# Added by adminpanel-setup. Password sign-in over SSH from this machine only, and only for members of "$grp".
Match Address 127.0.0.1,::1 Group $grp
    PasswordAuthentication yes
Match all
EOF
    fi
    chmod 644 "$f"
    chk=$(mktemp)
    if ! $sshd -t 2>"$chk"; then
        cp "$bak" "$f"; cat "$chk" >&2; rm -f "$chk" "$bak"
        die "the SSH server rejected the change, so the previous file was put back"
    fi
    rm -f "$chk" "$bak"
    systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
    if [ "$grp" = off ]; then
        echo "password sign-in from this machine is allowed for every account again"
    else
        echo "password sign-in from this machine is now limited to members of the group '$grp'."
        echo "Add each account that should use the Terminal and File manager, for example:"
        echo "    sudo usermod -aG $grp YOURNAME"
        echo "Members now: $(getent group "$grp" | cut -d: -f4)"
    fi
}

step_tls() {
    local port="" regen=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --port) port="${2:-}"; shift 2 ;;
            --regen) regen=1; shift ;;
            *) die "unknown option: $1" ;;
        esac
    done
    [ -n "$port" ] || port=$(cat "$STATE/port" 2>/dev/null || echo "$DEFAULT_PORT")
    case "$port" in ''|*[!0-9]*) die "the port must be a number" ;; esac
    { [ "$port" -ge 1 ] && [ "$port" -le 65535 ]; } || die "the port must be 1 to 65535"
    command -v nginx >/dev/null 2>&1 || die "nginx is not installed (sudo apt install nginx)"
    if ss -H -ltnp "sport = :$port" 2>/dev/null | grep -v nginx | grep -q .; then
        die "port $port is already used by another program. Choose another: adminpanel-setup tls --port N"
    fi

    say "TLS certificate and web server site (port $port)"
    local ips names sans ip n have_san
    ips=$(hostname -I 2>/dev/null || true)
    names="$(hostname 2>/dev/null || true) $(hostname -f 2>/dev/null || true) localhost"
    sans="IP:127.0.0.1"
    for ip in $ips; do sans="$sans,IP:$ip"; done
    for n in $names; do
        case "$n" in ''|*[!A-Za-z0-9.-]*) continue ;; esac
        case ",$sans," in *",DNS:$n,"*) ;; *) sans="$sans,DNS:$n" ;; esac
    done
    if [ ! -f "$CERT" ] || [ ! -f "$KEY" ]; then regen=1; fi
    if [ "$regen" = 0 ]; then
        have_san=$(openssl x509 -in "$CERT" -noout -ext subjectAltName 2>/dev/null || true)
        for ip in $ips; do case "$have_san" in *"$ip"*) ;; *) regen=1 ;; esac; done
        openssl x509 -in "$CERT" -noout -checkend 2592000 >/dev/null 2>&1 || regen=1
    fi
    if [ "$regen" = 1 ]; then
        install -d -m 755 /etc/ssl/certs
        [ -d /etc/ssl/private ] || install -d -m 710 /etc/ssl/private
        openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 365 \
            -keyout "$KEY" -out "$CERT" -subj "/CN=$(hostname)" -addext "subjectAltName=$sans" >/dev/null 2>&1 \
            || die "could not create the certificate"
        chmod 600 "$KEY"; chmod 644 "$CERT"
        echo "created a self-signed certificate for: $sans"
    else
        echo "the existing certificate is still valid for this machine's addresses"
    fi

    local listen6=""
    [ -e /proc/net/if_inet6 ] && listen6="    listen [::]:$port ssl;"
    install -d "$SNIP" /etc/nginx/sites-available /etc/nginx/sites-enabled "$STATE"
    install -m 644 "$SHARE/nginx/adminpanel-upload.conf" "$SNIP/adminpanel-upload.conf"
    install -m 644 "$SHARE/nginx/adminpanel-disks.conf" "$SNIP/adminpanel-disks.conf"
    sed -e "s|@PORT@|$port|g" -e "s|^@LISTEN6@\$|$listen6|" "$SHARE/nginx/site.conf.tmpl" > "$SITE_AV"
    ln -sf "$SITE_AV" "$SITE_EN"
    chk=$(mktemp)
    if ! nginx -t >"$chk" 2>&1; then
        rm -f "$SITE_EN"; cat "$chk" >&2; rm -f "$chk"
        die "the web server rejected the configuration (shown above). The panel site was not enabled."
    fi
    rm -f "$chk"
    systemctl enable nginx >/dev/null 2>&1 || true
    systemctl reload nginx 2>/dev/null || systemctl restart nginx
    echo "$port" > "$STATE/port"
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q '^Status: active'; then
        warn "the firewall (ufw) is active. Allow the panel with:  sudo ufw allow $port/tcp"
    fi
}

count_users() {
    runuser -u adminpanel -- "$PY" -c "import json
try:
    print(len(json.load(open('$APP/users.json'))))
except Exception:
    print(0)"
}

step_user() {
    local n a
    n=$(count_users)
    if [ "$n" -gt 0 ]; then
        read -r -p "An administrator already exists. Create another, or reset a password? [y/N] " a || a=n
        case "$a" in y|Y) ;; *) return 0 ;; esac
    fi
    say "Create the panel administrator (the password needs at least 8 characters)"
    ( cd "$APP" && runuser -u adminpanel -- "$PY" create_user.py )
    CREATED=1
}

step_2fa() {
    local try ok=0
    say "Two-step verification: scan the QR code with an authenticator app, then type the 6-digit code"
    for try in 1 2 3; do
        if ( cd "$APP" && runuser -u adminpanel -- "$PY" enroll_2fa.py ); then ok=1; break; fi
        echo "That did not work. Trying again ($try of 3)."
    done
    [ "$ok" = 1 ] || warn "two-step verification was not set up. Run: sudo adminpanel-setup 2fa"
}

finish() {
    local port ip
    systemctl restart adminpanel.service
    sleep 2
    say "Checking the installation"
    /usr/sbin/adminpanel-selfcheck || true
    port=$(cat "$STATE/port" 2>/dev/null || echo "$DEFAULT_PORT")
    say "Done. Open the panel in a browser:"
    for ip in $(hostname -I 2>/dev/null); do
        case "$ip" in *:*) echo "  https://[$ip]:$port" ;; *) echo "  https://$ip:$port" ;; esac
    done
    echo "  (the certificate is self-signed, so the browser shows a warning the first time)"
}

# ---------------------------------------------------------------- managing other machines
REMOTE_USER=adminpanel-remote
REMOTE_KEY="$STATE/remote_key"
REMOTE_KNOWN="$STATE/remote_known_hosts"

remote_key_make() {
    command -v ssh-keygen >/dev/null 2>&1 || die "ssh-keygen is missing (sudo apt install openssh-client)"
    install -d -m 755 "$STATE"
    if [ ! -f "$REMOTE_KEY" ]; then
        ssh-keygen -q -t ed25519 -N "" -C adminpanel-central -f "$REMOTE_KEY"
    fi
    # Root owns the key; the panel (group adminpanel) can read it but not replace it.
    chown root:adminpanel "$REMOTE_KEY"; chmod 640 "$REMOTE_KEY"
    chown root:root "$REMOTE_KEY.pub"; chmod 644 "$REMOTE_KEY.pub"
}

step_remote_key() {
    say "This panel's key for managing other machines"
    remote_key_make
    echo "On each machine you want to manage, install the panel there first, then run:"
    echo
    echo "  sudo adminpanel-setup remote-enable '$(cat "$REMOTE_KEY.pub")'"
}

step_remote_enable() {
    local key="${1:-}" home="/var/lib/adminpanel-remote" tmp fp eff
    say "Letting a central panel manage this machine (bridge only)"
    [[ "$key" =~ ^ssh-ed25519\ [A-Za-z0-9+/]+=*(\ [A-Za-z0-9._@-]+)?$ ]] \
        || die "usage: adminpanel-setup remote-enable 'ssh-ed25519 AAAA... adminpanel-central'   (the line printed by: adminpanel-setup remote-key)"
    [ -f "$APP/bridge.py" ] || die "this machine has no $APP/bridge.py. Install adminpanel 1.0.5 or later first."
    [ -x /usr/bin/python3 ] || die "/usr/bin/python3 is missing"
    [ -f /etc/sudoers.d/adminpanel ] || die "/etc/sudoers.d/adminpanel is missing. Reinstall the adminpanel package."
    if ! id "$REMOTE_USER" >/dev/null 2>&1; then
        useradd --system --create-home --home-dir "$home" --shell /bin/sh --comment "AdminPanel remote bridge" "$REMOTE_USER"
    fi
    usermod -p '*' "$REMOTE_USER"                          # no password; the key is the only way in
    install -d -m 700 -o "$REMOTE_USER" -g "$REMOTE_USER" "$home/.ssh"
    chmod 755 "$home"
    # The key may run the bridge and nothing else ("restrict" turns off shells, forwarding and agents).
    printf 'command="/usr/bin/python3 %s/bridge.py",restrict %s\n' "$APP" "$key" > "$home/.ssh/authorized_keys"
    chown "$REMOTE_USER:$REMOTE_USER" "$home/.ssh/authorized_keys"; chmod 600 "$home/.ssh/authorized_keys"
    # The same sudo rules the panel itself has, for this user (one source of truth).
    tmp=$(mktemp)
    sed -e 's/PANEL_SVC/REMOTE_SVC/g' -e "s/^adminpanel ALL/$REMOTE_USER ALL/" /etc/sudoers.d/adminpanel > "$tmp"
    if ! visudo -cf "$tmp" >/dev/null 2>&1; then rm -f "$tmp"; die "the generated sudo rule is invalid. Nothing was installed."; fi
    install -m 0440 -o root -g root "$tmp" "/etc/sudoers.d/$REMOTE_USER"; rm -f "$tmp"
    if command -v /usr/sbin/sshd >/dev/null 2>&1; then
        eff=$(/usr/sbin/sshd -T -C "user=$REMOTE_USER,host=localhost,addr=127.0.0.1,laddr=127.0.0.1,lport=22" 2>/dev/null || true)
        printf '%s\n' "$eff" | grep -qi '^pubkeyauthentication no' && warn "SSH public-key sign-in is switched off on this machine"
        printf '%s\n' "$eff" | grep -qiE '^(allowusers|allowgroups) ' && warn "SSH has an AllowUsers or AllowGroups rule. Make sure $REMOTE_USER is allowed"
    else
        warn "no SSH server is installed (sudo apt install openssh-server)"
    fi
    echo "done. The central panel can now run only the bridge here, as user $REMOTE_USER."
    echo
    echo "This machine's SSH host key, to compare when you add it on the central panel:"
    for f in /etc/ssh/ssh_host_ed25519_key.pub; do
        [ -f "$f" ] && ssh-keygen -lf "$f"
    done
    echo
    echo "On the central panel run:  sudo adminpanel-setup add-host NAME THIS-MACHINE-ADDRESS"
}

step_remote_disable() {
    say "Removing the central panel's access to this machine"
    rm -f "/etc/sudoers.d/$REMOTE_USER"
    if id "$REMOTE_USER" >/dev/null 2>&1; then userdel -r "$REMOTE_USER" 2>/dev/null || userdel "$REMOTE_USER"; fi
    echo "done"
}

panel_py() { ( cd "$APP" && ADMINPANEL_STATE="$STATE" runuser -u adminpanel -- "$PY" -c "$@" ); }

step_add_host() {
    local name="${1:-}" addr="${2:-}" port=22 want="" scan fp hid out tmp spec
    [ $# -ge 2 ] || die "usage: adminpanel-setup add-host NAME ADDRESS [PORT] [--fingerprint SHA256:...]"
    shift 2
    while [ $# -gt 0 ]; do
        case "$1" in
            --fingerprint) want="${2:-}"; shift 2 || die "--fingerprint needs a value" ;;
            [0-9]*) port="$1"; shift ;;
            *) die "unexpected argument: $1" ;;
        esac
    done
    [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,39}$ ]] || die "the name may use letters, digits, dot, dash and underscore (up to 40 characters)"
    [[ "$addr" =~ ^[A-Za-z0-9._:-]{1,253}$ && "$addr" != -* && "$addr" != .* ]] || die "that is not a valid address"
    [[ "$port" =~ ^[0-9]{1,5}$ ]] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || die "the port must be a number from 1 to 65535"
    command -v ssh-keyscan >/dev/null 2>&1 || die "ssh-keyscan is missing (sudo apt install openssh-client)"
    say "Adding $name ($addr:$port)"
    remote_key_make
    scan=$(mktemp)
    ssh-keyscan -T 6 -t ed25519 -p "$port" "$addr" 2>/dev/null | grep -v '^#' > "$scan" || true
    [ -s "$scan" ] || { rm -f "$scan"; die "could not read an SSH host key from $addr port $port"; }
    [ "$(wc -l < "$scan")" -eq 1 ] || { rm -f "$scan"; die "the server returned more than one host key; refusing"; }
    fp=$(ssh-keygen -lf "$scan" | awk '{print $2}')
    echo "That machine's SSH host key fingerprint is:"
    echo "  $fp"
    if [ -n "$want" ]; then
        [ "$want" = "$fp" ] || { rm -f "$scan"; die "the fingerprint does not match the one you gave ($want). Nothing was changed."; }
        echo "(matches the fingerprint you gave)"
    else
        [ -t 0 ] || { rm -f "$scan"; die "no terminal to ask on. Compare the fingerprint, then run again with: --fingerprint $fp"; }
        echo "Compare it with the output of 'remote-enable' on that machine."
        read -r -p "Does it match? [y/N] " ans
        [ "$ans" = y ] || [ "$ans" = Y ] || { rm -f "$scan"; die "not confirmed. Nothing was changed."; }
    fi
    # Pin the key in the root-owned file; the panel can read it but not change it.
    install -d -m 755 "$STATE"; touch "$REMOTE_KNOWN"
    spec="$addr"; [ "$port" != 22 ] && spec="[$addr]:$port"
    ssh-keygen -R "$spec" -f "$REMOTE_KNOWN" >/dev/null 2>&1 || true
    rm -f "$REMOTE_KNOWN.old"
    cat "$scan" >> "$REMOTE_KNOWN"; rm -f "$scan"
    chown root:adminpanel "$REMOTE_KNOWN"; chmod 640 "$REMOTE_KNOWN"
    if ! hid=$(panel_py "import sys, remote
try:
    print(remote.add_host(sys.argv[1], sys.argv[2], int(sys.argv[3])))
except ValueError as e:
    sys.exit(str(e))" "$name" "$addr" "$port" 2>&1); then
        die "$hid"
    fi
    echo "added (id $hid). Testing the connection..."
    if out=$(panel_py "import sys, remote
try:
    r = remote.call(sys.argv[1], 'ping')
    print('the bridge answered: version', r['version'])
except remote.RemoteError as e:
    sys.exit(e.message)" "$hid" 2>&1); then
        echo "$out"
    else
        warn "added, but the test failed: $out"
        echo "Check that 'sudo adminpanel-setup remote-enable ...' was run on $addr, and that port $port is reachable."
    fi
}

step_remove_host() {
    local name="${1:-}"
    [ -n "$name" ] || die "usage: adminpanel-setup remove-host NAME"
    panel_py "import sys, remote
try:
    remote.remove_host(sys.argv[1])
except ValueError as e:
    sys.exit(str(e))" "$name" || die "could not remove $name"
    echo "removed $name from the list (its pinned host key stays in $REMOTE_KNOWN; the machine itself is not changed)"
}

step_list_hosts() {
    panel_py "import remote
rows = remote.list_hosts()
if not rows: print('no machines listed')
for hid, name, addr, port in rows: print(f'{hid}  {name:<20} {addr}:{port}')"
}

cmd="${1:-all}"; [ $# -gt 0 ] && shift || true
case "$cmd" in
    all)
        step_ssh
        step_ssh_local
        step_tls "$@"
        step_user
        [ "$CREATED" = 1 ] && step_2fa
        finish
        ;;
    tls)        step_tls "$@"; systemctl restart adminpanel.service ;;
    ssh)        step_ssh ;;
    ssh-local)  step_ssh_local ;;
    ssh-restrict) step_ssh_restrict "$@" ;;
    user)       step_user ;;
    2fa)        step_2fa ;;
    remote-key)     step_remote_key ;;
    remote-enable)  step_remote_enable "$@" ;;
    remote-disable) step_remote_disable ;;
    add-host)       step_add_host "$@" ;;
    remove-host)    step_remove_host "$@" ;;
    list-hosts)     step_list_hosts ;;
    *)          sed -n '2,16p' "$0"; exit 2 ;;
esac
