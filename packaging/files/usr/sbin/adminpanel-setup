#!/bin/bash
# adminpanel-setup: first-run setup and maintenance for the admin panel.
#   sudo adminpanel-setup                          everything, in order
#   sudo adminpanel-setup tls [--port N] [--regen] certificate and web server site
#   sudo adminpanel-setup ssh                      pin this machine's SSH host key
#   sudo adminpanel-setup ssh-local                allow password sign-in over SSH from this machine only
#   sudo adminpanel-setup user                     create or reset a panel administrator
#   sudo adminpanel-setup 2fa                      set up two-step verification
set -euo pipefail

APP=/opt/adminpanel
PY="$APP/.venv/bin/python"
SHARE=/usr/share/adminpanel
CERT=/etc/ssl/certs/adminpanel.crt
KEY=/etc/ssl/private/adminpanel.key
SITE_AV=/etc/nginx/sites-available/adminpanel.conf
SITE_EN=/etc/nginx/sites-enabled/adminpanel.conf
SNIP=/etc/nginx/snippets
STATE=/var/lib/adminpanel
DEFAULT_PORT=8443
CREATED=0

say()  { printf '\n== %s\n' "$*"; }
warn() { printf 'WARNING: %s\n' "$*" >&2; }
die()  { printf 'ERROR: %s\n' "$*" >&2; exit 1; }

[ "$(id -u)" -eq 0 ] || die "run this with sudo"
[ -x "$PY" ] || die "the panel's Python environment is missing. Reinstall the package."

step_ssh() {
    say "Pinning this machine's SSH host key (used by the Terminal and File manager)"
    if [ ! -f /etc/ssh/ssh_host_ed25519_key.pub ] && command -v ssh-keygen >/dev/null 2>&1; then
        ssh-keygen -A >/dev/null 2>&1 || true
    fi
    if [ -f /etc/ssh/ssh_host_ed25519_key.pub ]; then
        printf '127.0.0.1 %s\n' "$(cut -d' ' -f1,2 /etc/ssh/ssh_host_ed25519_key.pub)" > "$APP/ssh_known_hosts"
        chown adminpanel:adminpanel "$APP/ssh_known_hosts"
        chmod 640 "$APP/ssh_known_hosts"
        echo "done"
    else
        warn "no SSH host key found. The Terminal and File manager will not work (sudo apt install openssh-server, then run: adminpanel-setup ssh)"
    fi
    if ! systemctl is-active --quiet ssh 2>/dev/null && ! systemctl is-active --quiet sshd 2>/dev/null; then
        warn "the SSH server is not running. The Terminal and File manager need it (sudo apt install openssh-server)"
    fi
}

step_ssh_local() {
    say "Password sign-in over SSH from this machine only"
    local sshd=/usr/sbin/sshd eff remote f=/etc/ssh/sshd_config.d/60-adminpanel-localhost.conf
    [ -x "$sshd" ] || { warn "no SSH server is installed (sudo apt install openssh-server)"; return 0; }
    eff=$($sshd -T -C user=root,host=localhost,addr=127.0.0.1,laddr=127.0.0.1,lport=22 2>/dev/null | awk '$1=="passwordauthentication"{print $2}')
    if [ "$eff" = "yes" ]; then echo "already allowed for connections from this machine"; return 0; fi
    [ -d /etc/ssh/sshd_config.d ] || die "this SSH server has no sshd_config.d folder. Add this to /etc/ssh/sshd_config by hand: Match Address 127.0.0.1,::1 / PasswordAuthentication yes / Match all"
    cat > "$f" <<EOF
# Added by adminpanel-setup. Allows the panel Terminal and File manager to sign in from this machine only.
Match Address 127.0.0.1,::1
    PasswordAuthentication yes
Match all
EOF
    chmod 644 "$f"
    if ! $sshd -t 2>/tmp/adminpanel-sshd-check.log; then
        rm -f "$f"; cat /tmp/adminpanel-sshd-check.log >&2
        die "the SSH server rejected the change, so it was removed"
    fi
    systemctl reload ssh 2>/dev/null || systemctl reload sshd 2>/dev/null || true
    eff=$($sshd -T -C user=root,host=localhost,addr=127.0.0.1,laddr=127.0.0.1,lport=22 2>/dev/null | awk '$1=="passwordauthentication"{print $2}')
    remote=$($sshd -T -C user=root,host=example,addr=192.0.2.10,laddr=192.0.2.1,lport=22 2>/dev/null | awk '$1=="passwordauthentication"{print $2}')
    echo "password sign-in from this machine: ${eff:-unknown}; from other machines: ${remote:-unknown}"
    echo "Linux accounts still need a password to use these tools (for example: sudo passwd YOURNAME)."
}

step_tls() {
    local port="" regen=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --port) port="${2:-}"; shift 2 ;;
            --regen) regen=1; shift ;;
            *) die "unknown option: $1" ;;
        esac
    done
    [ -n "$port" ] || port=$(cat "$STATE/port" 2>/dev/null || echo "$DEFAULT_PORT")
    case "$port" in ''|*[!0-9]*) die "the port must be a number" ;; esac
    { [ "$port" -ge 1 ] && [ "$port" -le 65535 ]; } || die "the port must be 1 to 65535"
    command -v nginx >/dev/null 2>&1 || die "nginx is not installed (sudo apt install nginx)"
    if ss -H -ltnp "sport = :$port" 2>/dev/null | grep -v nginx | grep -q .; then
        die "port $port is already used by another program. Choose another: adminpanel-setup tls --port N"
    fi

    say "TLS certificate and web server site (port $port)"
    local ips names sans ip n have_san
    ips=$(hostname -I 2>/dev/null || true)
    names="$(hostname 2>/dev/null || true) $(hostname -f 2>/dev/null || true) localhost"
    sans="IP:127.0.0.1"
    for ip in $ips; do sans="$sans,IP:$ip"; done
    for n in $names; do
        case "$n" in ''|*[!A-Za-z0-9.-]*) continue ;; esac
        case ",$sans," in *",DNS:$n,"*) ;; *) sans="$sans,DNS:$n" ;; esac
    done
    if [ ! -f "$CERT" ] || [ ! -f "$KEY" ]; then regen=1; fi
    if [ "$regen" = 0 ]; then
        have_san=$(openssl x509 -in "$CERT" -noout -ext subjectAltName 2>/dev/null || true)
        for ip in $ips; do case "$have_san" in *"$ip"*) ;; *) regen=1 ;; esac; done
        openssl x509 -in "$CERT" -noout -checkend 2592000 >/dev/null 2>&1 || regen=1
    fi
    if [ "$regen" = 1 ]; then
        install -d -m 755 /etc/ssl/certs
        [ -d /etc/ssl/private ] || install -d -m 710 /etc/ssl/private
        openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -days 365 \
            -keyout "$KEY" -out "$CERT" -subj "/CN=$(hostname)" -addext "subjectAltName=$sans" >/dev/null 2>&1 \
            || die "could not create the certificate"
        chmod 600 "$KEY"; chmod 644 "$CERT"
        echo "created a self-signed certificate for: $sans"
    else
        echo "the existing certificate is still valid for this machine's addresses"
    fi

    local listen6=""
    [ -e /proc/net/if_inet6 ] && listen6="    listen [::]:$port ssl;"
    install -d "$SNIP" /etc/nginx/sites-available /etc/nginx/sites-enabled "$STATE"
    install -m 644 "$SHARE/nginx/adminpanel-upload.conf" "$SNIP/adminpanel-upload.conf"
    install -m 644 "$SHARE/nginx/adminpanel-disks.conf" "$SNIP/adminpanel-disks.conf"
    sed -e "s|@PORT@|$port|g" -e "s|^@LISTEN6@\$|$listen6|" "$SHARE/nginx/site.conf.tmpl" > "$SITE_AV"
    ln -sf "$SITE_AV" "$SITE_EN"
    if ! nginx -t >/tmp/adminpanel-nginx-check.log 2>&1; then
        rm -f "$SITE_EN"; cat /tmp/adminpanel-nginx-check.log >&2
        die "the web server rejected the configuration (shown above). The panel site was not enabled."
    fi
    systemctl enable nginx >/dev/null 2>&1 || true
    systemctl reload nginx 2>/dev/null || systemctl restart nginx
    echo "$port" > "$STATE/port"
    if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q '^Status: active'; then
        warn "the firewall (ufw) is active. Allow the panel with:  sudo ufw allow $port/tcp"
    fi
}

count_users() {
    runuser -u adminpanel -- "$PY" -c "import json
try:
    print(len(json.load(open('$APP/users.json'))))
except Exception:
    print(0)"
}

step_user() {
    local n a
    n=$(count_users)
    if [ "$n" -gt 0 ]; then
        read -r -p "An administrator already exists. Create another, or reset a password? [y/N] " a || a=n
        case "$a" in y|Y) ;; *) return 0 ;; esac
    fi
    say "Create the panel administrator (the password needs at least 12 characters)"
    ( cd "$APP" && runuser -u adminpanel -- "$PY" create_user.py )
    CREATED=1
}

step_2fa() {
    local try ok=0
    say "Two-step verification: scan the QR code with an authenticator app, then type the 6-digit code"
    for try in 1 2 3; do
        if ( cd "$APP" && runuser -u adminpanel -- "$PY" enroll_2fa.py ); then ok=1; break; fi
        echo "That did not work. Trying again ($try of 3)."
    done
    [ "$ok" = 1 ] || warn "two-step verification was not set up. Run: sudo adminpanel-setup 2fa"
}

finish() {
    local port ip
    systemctl restart adminpanel.service
    sleep 2
    say "Checking the installation"
    /usr/sbin/adminpanel-selfcheck || true
    port=$(cat "$STATE/port" 2>/dev/null || echo "$DEFAULT_PORT")
    say "Done. Open the panel in a browser:"
    for ip in $(hostname -I 2>/dev/null); do
        case "$ip" in *:*) echo "  https://[$ip]:$port" ;; *) echo "  https://$ip:$port" ;; esac
    done
    echo "  (the certificate is self-signed, so the browser shows a warning the first time)"
}

cmd="${1:-all}"; [ $# -gt 0 ] && shift || true
case "$cmd" in
    all)
        step_ssh
        step_ssh_local
        step_tls "$@"
        step_user
        [ "$CREATED" = 1 ] && step_2fa
        finish
        ;;
    tls)        step_tls "$@"; systemctl restart adminpanel.service ;;
    ssh)        step_ssh ;;
    ssh-local)  step_ssh_local ;;
    user)       step_user ;;
    2fa)        step_2fa ;;
    *)          sed -n '2,9p' "$0"; exit 2 ;;
esac
