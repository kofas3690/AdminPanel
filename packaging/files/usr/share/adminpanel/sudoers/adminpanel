# Installed by the adminpanel package.
Cmnd_Alias PANEL_SVC = \
    /usr/bin/systemctl start nginx, \
    /usr/bin/systemctl restart nginx, \
    /usr/bin/systemctl start cron, \
    /usr/bin/systemctl stop cron, \
    /usr/bin/systemctl restart cron, \
    /usr/bin/systemctl enable nginx, \
    /usr/bin/systemctl disable nginx, \
    /usr/bin/systemctl enable cron, \
    /usr/bin/systemctl disable cron, \
    /usr/bin/systemctl restart ssh, \
    /usr/bin/systemctl --no-block reboot, \
    /usr/bin/systemctl --no-block poweroff

# Hardware page: lists the memory modules (read only). Not copied to the remote-management user.
Cmnd_Alias PANEL_HW = /usr/sbin/dmidecode -t memory

adminpanel ALL=(root) NOPASSWD: PANEL_SVC
adminpanel ALL=(root) NOPASSWD: PANEL_HW
