#!/usr/bin/python3 -I
"""Root helper for the Blocked addresses page (fail2ban): list jails with the addresses they currently block,
and lift one block. It cannot ban an address, change a jail or edit any fail2ban setting.

A jail must be one that fail2ban itself lists, and an address must be a valid IPv4 or IPv6 address."""
import ipaddress, json, os, re, subprocess, sys

CLIENT = "/usr/bin/fail2ban-client"
ENV = {"PATH": "/usr/bin:/bin", "LC_ALL": "C"}
JAIL_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]{0,39}")
CTRL = re.compile(r"[\x00-\x1f\x7f]")
MAX_IPS = 500


def die(msg, code=2):
    print(msg, file=sys.stderr)
    sys.exit(code)


def f2b(*args, timeout=20):
    try:
        return subprocess.run([CLIENT, *args], capture_output=True, text=True, errors="replace", env=ENV,
                              stdin=subprocess.DEVNULL, timeout=timeout)
    except subprocess.TimeoutExpired:
        die("fail2ban did not answer in time", 1)


def after(text, label):
    for line in text.splitlines():
        if label in line:
            return CTRL.sub("", line.split(label, 1)[1]).strip()
    return ""


def jails():
    r = f2b("status")
    if r.returncode != 0:
        return None, CTRL.sub("", (r.stderr or r.stdout or "").strip().splitlines()[-1] if (r.stderr or r.stdout).strip() else "the fail2ban service is not running")[:200]
    names = [j.strip() for j in after(r.stdout, "Jail list:").split(",") if JAIL_RE.fullmatch(j.strip())]
    return names, ""


def num(s):
    try:
        return int(s)
    except ValueError:
        return 0


def getval(jail, key):
    r = f2b("get", jail, key)
    return CTRL.sub("", r.stdout.strip())[:20] if r.returncode == 0 else ""


def cmd_list():
    if not os.path.exists(CLIENT):
        print(json.dumps({"installed": False, "running": False, "jails": []}))
        return
    names, err = jails()
    if names is None:
        print(json.dumps({"installed": True, "running": False, "jails": [], "error": err}))
        return
    out = []
    for n in names:
        r = f2b("status", n)
        if r.returncode != 0:
            continue
        ips = []
        for tok in after(r.stdout, "Banned IP list:").split()[:MAX_IPS]:
            try:
                ips.append(str(ipaddress.ip_address(tok)))
            except ValueError:
                pass
        out.append({"name": n, "failed": num(after(r.stdout, "Currently failed:")),
                    "total_failed": num(after(r.stdout, "Total failed:")),
                    "banned": num(after(r.stdout, "Currently banned:")), "total_banned": num(after(r.stdout, "Total banned:")),
                    "ips": ips, "maxretry": getval(n, "maxretry"), "findtime": getval(n, "findtime"),
                    "bantime": getval(n, "bantime")})
    print(json.dumps({"installed": True, "running": True, "jails": out}))


def cmd_unban(jail, ip):
    names, err = jails()
    if names is None:
        die(err or "fail2ban is not running", 1)
    if not JAIL_RE.fullmatch(jail or "") or jail not in names:
        die("fail2ban has no such jail")
    try:
        ip = str(ipaddress.ip_address(ip))
    except ValueError:
        die("invalid address")
    r = f2b("set", jail, "unbanip", ip)
    if r.returncode != 0:
        e = (r.stderr or r.stdout or "failed").strip().splitlines()
        die(CTRL.sub("", e[-1] if e else "failed")[:240], 1)
    print("ok")


def main():
    a = sys.argv[1:]
    if a == ["list"]:
        return cmd_list()
    if a == ["check"]:
        return print(json.dumps({"ok": True}))
    if len(a) == 3 and a[0] == "unban":
        return cmd_unban(a[1], a[2])
    die("usage: list | unban JAIL ADDRESS | check")


main()
