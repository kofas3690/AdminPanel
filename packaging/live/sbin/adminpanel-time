#!/usr/bin/python3 -I
"""Root helper for the Date & time page: change the time zone, switch network time on or off, set the hostname.

Every value is checked here, as root, whatever the panel sent: a time zone must be one that timedatectl lists,
a hostname must be a valid name, and nothing is passed through a shell."""
import json, os, re, socket, subprocess, sys, tempfile

TIMEDATECTL = "/usr/bin/timedatectl"
HOSTNAMECTL = "/usr/bin/hostnamectl"
HOSTS = "/etc/hosts"
ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C"}
ZONE_RE = re.compile(r"[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+){0,2}")
LABEL = r"[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?"
HOST_RE = re.compile(LABEL + r"(\." + LABEL + r")*")


def die(msg, code=2):
    print(msg, file=sys.stderr)
    sys.exit(code)


def run(args):
    try:
        r = subprocess.run(args, capture_output=True, text=True, timeout=30, env=ENV, stdin=subprocess.DEVNULL)
    except (OSError, subprocess.TimeoutExpired):
        die("The system tool did not answer")
    if r.returncode != 0:
        die((r.stderr or r.stdout).strip()[:200] or "The system tool failed", 1)
    return r.stdout


def cmd_timezone(z):
    if not ZONE_RE.fullmatch(z) or len(z) > 64:
        die("That is not a time zone name")
    if z not in run([TIMEDATECTL, "list-timezones"]).split():
        die("Unknown time zone")
    run([TIMEDATECTL, "set-timezone", z])
    print(json.dumps({"ok": True, "timezone": z}))


def cmd_ntp(v):
    if v not in ("on", "off"):
        die("usage: ntp on|off")
    run([TIMEDATECTL, "set-ntp", "true" if v == "on" else "false"])
    print(json.dumps({"ok": True, "ntp": v}))


def fix_hosts(old, new):
    """Debian and Ubuntu list the machine's own name on a 127.0.1.1 line; keep it in step so sudo does not complain."""
    try:
        with open(HOSTS) as f:
            lines = f.read().split("\n")
    except OSError:
        return False
    changed = False
    for i, line in enumerate(lines):
        body = line.split("#", 1)[0].split()
        if body and body[0] == "127.0.1.1" and old in body[1:]:
            lines[i] = re.sub(r"(?<![^\s])" + re.escape(old) + r"(?![^\s])", new, line)
            changed = True
    if not changed:
        return False
    st = os.stat(HOSTS)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(HOSTS), prefix=".hosts.")
    with os.fdopen(fd, "w") as f:
        f.write("\n".join(lines))
    os.chmod(tmp, st.st_mode & 0o7777)
    os.replace(tmp, HOSTS)
    return True


def cmd_hostname(name):
    if len(name) > 253 or not HOST_RE.fullmatch(name):
        die("A hostname uses lower-case letters, digits and hyphens, in parts of up to 63 characters")
    old = socket.gethostname()
    run([HOSTNAMECTL, "set-hostname", name])
    print(json.dumps({"ok": True, "hostname": name, "hosts_updated": fix_hosts(old, name) if old != name else False}))


def main():
    a = sys.argv[1:]
    if len(a) == 2 and a[0] == "timezone":
        return cmd_timezone(a[1])
    if len(a) == 2 and a[0] == "ntp":
        return cmd_ntp(a[1])
    if len(a) == 2 and a[0] == "hostname":
        return cmd_hostname(a[1])
    if a == ["check"]:
        return print(json.dumps({"ok": True, "timedatectl": os.path.exists(TIMEDATECTL)}))
    die("usage: timezone ZONE | ntp on|off | hostname NAME | check")


main()
