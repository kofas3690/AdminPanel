#!/usr/bin/python3 -I
"""Root helper for the Swap page: show swap memory, create or remove the swap file, set swappiness.

It only ever touches one file, /swapfile. The caller can choose a size in megabytes or a swappiness number and nothing
else: no path, no device and no command line reaches a program."""
import json, os, re, stat, subprocess, sys, tempfile

SWAPFILE = "/swapfile"
FSTAB = "/etc/fstab"
FSTAB_LINE = "/swapfile none swap sw 0 0"
PROC_SWAPS = "/proc/swaps"
MEMINFO = "/proc/meminfo"
SWAPPINESS = "/proc/sys/vm/swappiness"
SYSCTL_CONF = "/etc/sysctl.d/99-adminpanel-swap.conf"
FALLOCATE, MKSWAP, SWAPON, SWAPOFF = "/usr/bin/fallocate", "/usr/sbin/mkswap", "/usr/sbin/swapon", "/usr/sbin/swapoff"
SYSCTL = "/usr/sbin/sysctl"
ENV = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C"}
MIN_MB, MAX_MB = 128, 65536
MARGIN_MB = 1024  # always leave this much free on the disk
CTRL = re.compile(r"[\x00-\x1f\x7f]")


def die(msg, code=2):
    print(msg, file=sys.stderr)
    sys.exit(code)


def run(*args, timeout=600):
    try:
        r = subprocess.run(list(args), capture_output=True, text=True, errors="replace", env=ENV,
                           stdin=subprocess.DEVNULL, timeout=timeout)
    except subprocess.TimeoutExpired:
        die("The command took too long", 1)
    except OSError as e:
        die("Could not run " + os.path.basename(args[0]) + ": " + CTRL.sub("", str(e))[:100], 1)
    return r


def fail(r, what):
    e = (r.stderr or r.stdout or "failed").strip().splitlines()
    die(what + ": " + CTRL.sub("", e[-1] if e else "failed")[:200], 1)


def active():
    out = []
    try:
        lines = open(PROC_SWAPS).read().splitlines()[1:]
    except OSError:
        return out
    for line in lines:
        f = line.split()
        if len(f) >= 5 and f[2].isdigit() and f[3].isdigit():
            out.append({"path": CTRL.sub("", f[0].replace("\\040", " "))[:200], "type": f[1][:20],
                        "size_mb": int(f[2]) // 1024, "used_mb": int(f[3]) // 1024, "priority": f[4]})
    return out


def meminfo(key):
    try:
        for line in open(MEMINFO):
            if line.startswith(key + ":"):
                return int(line.split()[1]) // 1024
    except (OSError, ValueError, IndexError):
        pass
    return 0


def read_swappiness():
    try:
        return int(open(SWAPPINESS).read().strip())
    except (OSError, ValueError):
        return None


def free_mb(path):
    st = os.statvfs(os.path.dirname(path) or "/")
    return st.f_bavail * st.f_frsize // (1024 * 1024)


def in_fstab():
    try:
        return any(l.split()[:1] == [SWAPFILE] and "swap" in l.split() for l in open(FSTAB) if l.strip() and not l.lstrip().startswith("#"))
    except OSError:
        return False


def rewrite_fstab(add):
    try:
        lines = open(FSTAB).read().splitlines()
    except OSError:
        lines = []
    keep = [l for l in lines if not (l.strip() and not l.lstrip().startswith("#") and l.split()[:1] == [SWAPFILE])]
    if add:
        keep.append(FSTAB_LINE)
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(FSTAB), prefix=".fstab.")
    try:
        with os.fdopen(fd, "w") as f:
            f.write("\n".join(keep) + "\n")
        try:
            os.chmod(tmp, os.stat(FSTAB).st_mode & 0o777)
        except OSError:
            os.chmod(tmp, 0o644)
        os.replace(tmp, FSTAB)
    except OSError as e:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        die("Could not update /etc/fstab: " + CTRL.sub("", str(e))[:120], 1)


def cmd_status():
    f = None
    try:
        st = os.lstat(SWAPFILE)
        f = {"size_mb": st.st_size // (1024 * 1024), "regular": stat.S_ISREG(st.st_mode)}
    except OSError:
        pass
    try:
        free = free_mb(SWAPFILE)
    except OSError:
        free = 0
    print(json.dumps({"swaps": active(), "mem_mb": meminfo("MemTotal"), "swap_total_mb": meminfo("SwapTotal"),
                      "swap_free_mb": meminfo("SwapFree"), "swappiness": read_swappiness(),
                      "file": f, "file_in_fstab": in_fstab(), "disk_free_mb": free,
                      "min_mb": MIN_MB, "max_mb": MAX_MB, "margin_mb": MARGIN_MB}))


def cmd_create(arg):
    if not re.fullmatch(r"[0-9]{1,6}", arg or ""):
        die("invalid size")
    mb = int(arg)
    if not MIN_MB <= mb <= MAX_MB:
        die("The size must be between %d and %d MB" % (MIN_MB, MAX_MB))
    if os.path.lexists(SWAPFILE):
        die("A swap file already exists. Remove it first.", 1)
    if free_mb(SWAPFILE) < mb + MARGIN_MB:
        die("Not enough free disk space: %d MB free, and %d MB must stay free after the file is made" % (free_mb(SWAPFILE), MARGIN_MB), 1)
    r = run(FALLOCATE, "-l", "%dM" % mb, SWAPFILE)
    if r.returncode != 0:
        try:
            os.unlink(SWAPFILE)
        except OSError:
            pass
        fail(r, "Could not allocate the file")
    try:
        os.chmod(SWAPFILE, 0o600)
    except OSError:
        pass
    r = run(MKSWAP, SWAPFILE)
    if r.returncode != 0:
        os.unlink(SWAPFILE)
        fail(r, "mkswap failed")
    r = run(SWAPON, SWAPFILE)
    if r.returncode != 0:
        os.unlink(SWAPFILE)
        fail(r, "swapon failed")
    rewrite_fstab(True)
    print("ok")


def cmd_remove():
    if not os.path.lexists(SWAPFILE) and not in_fstab():
        die("There is no swap file", 1)
    if any(s["path"] == SWAPFILE for s in active()):
        r = run(SWAPOFF, SWAPFILE)
        if r.returncode != 0:
            fail(r, "swapoff failed (is there enough free memory to move the swapped data back?)")
    rewrite_fstab(False)
    try:
        st = os.lstat(SWAPFILE)
        if stat.S_ISREG(st.st_mode):
            os.unlink(SWAPFILE)
    except OSError:
        pass
    print("ok")


def cmd_swappiness(arg):
    if not re.fullmatch(r"[0-9]{1,3}", arg or "") or int(arg) > 100:
        die("swappiness must be a number from 0 to 100")
    n = int(arg)
    r = run(SYSCTL, "-w", "vm.swappiness=%d" % n, timeout=20)
    if r.returncode != 0:
        fail(r, "Could not set swappiness")
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(SYSCTL_CONF), prefix=".sw.")
    try:
        with os.fdopen(fd, "w") as f:
            f.write("vm.swappiness = %d\n" % n)
        os.chmod(tmp, 0o644)
        os.replace(tmp, SYSCTL_CONF)
    except OSError as e:
        die("Set for now, but could not save it for the next boot: " + CTRL.sub("", str(e))[:100], 1)
    print("ok")


def main():
    a = sys.argv[1:]
    if a == ["status"]:
        return cmd_status()
    if a == ["check"]:
        return print(json.dumps({"ok": True}))
    if a == ["remove"]:
        return cmd_remove()
    if len(a) == 2 and a[0] == "create":
        return cmd_create(a[1])
    if len(a) == 2 and a[0] == "swappiness":
        return cmd_swappiness(a[1])
    die("usage: status | create MB | remove | swappiness N | check")


main()
