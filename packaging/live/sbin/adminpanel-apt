#!/bin/sh
# Root helper for the Software updates page: "update", "upgrade", and (3.2.0) "install NAME" / "remove NAME".
#
# The job runs as its own transient systemd unit (adminpanel-apt-job.service), NOT as a
# child of the panel. Restarting or crashing the panel therefore cannot kill apt halfway
# through a package change. The panel reads the progress from the files below:
#   apt-job.log   everything the job printed
#   apt-job.rc    the exit status, written when the job ends
#   apt-job.kind  update or upgrade
#   apt-job.id    a number that identifies this job
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
STATE=/var/lib/adminpanel
UNIT=adminpanel-apt-job

start_job() {
    kind="$1"; shift
    exec 9>/run/adminpanel-apt.lock
    flock -n 9 || { echo "Another request is being handled" >&2; exit 3; }
    state=$(systemctl show -p ActiveState --value "$UNIT.service" 2>/dev/null || true)
    case "$state" in
        active|activating|deactivating|reloading)
            echo "A job is already running" >&2
            exit 3
            ;;
    esac
    install -d -m 755 "$STATE"
    rm -f "$STATE/apt-job.rc"
    : > "$STATE/apt-job.log"
    echo "$kind" > "$STATE/apt-job.kind"
    date +%s%N > "$STATE/apt-job.id"
    chmod 644 "$STATE/apt-job.log" "$STATE/apt-job.kind" "$STATE/apt-job.id"
    systemd-run --quiet --collect --unit="$UNIT" --description="AdminPanel: apt $kind" \
        --setenv=DEBIAN_FRONTEND=noninteractive --setenv=NEEDRESTART_MODE=l --setenv=LC_ALL=C \
        -p "StandardOutput=append:$STATE/apt-job.log" \
        -p "StandardError=append:$STATE/apt-job.log" \
        /bin/sh -c 'kind=$1; shift
                    logger -t adminpanel-apt "$kind started"
                    "$@"; rc=$?
                    echo "$rc" > /var/lib/adminpanel/apt-job.rc
                    logger -t adminpanel-apt "$kind finished, exit status $rc"
                    exit "$rc"' sh "$kind" "$@"
    echo "started"
}

# --- install / remove: the name is checked here, as root, whatever the panel sent ---------------
# Packages whose removal would break the machine or the panel are never removed. The check is made on what the
# removal would take with it (apt's own dry run), not just on the name asked for.
PROTECTED_RE='^(adminpanel|sudo|openssh-server|openssh-client|nginx|nginx-common|nginx-core|systemd|systemd-sysv|apt|dpkg|libc6|python3|python3-minimal|netplan.io|cloud-init|grub-.*|linux-image-.*|linux-generic.*|linux-base|ubuntu-minimal|ubuntu-server|ubuntu-standard|ubuntu-desktop|ubuntu-desktop-minimal|ubuntu-server-minimal)$'

valid_name() {
    case "$1" in
        ''|-*|*[!a-z0-9+.-]*) return 1 ;;
    esac
    [ "${#1}" -ge 2 ] && [ "${#1}" -le 100 ]
}

check_install() {
    cand=$(apt-cache policy -- "$1" 2>/dev/null | sed -n 's/^  Candidate: //p')
    if [ -z "$cand" ] || [ "$cand" = "(none)" ]; then
        echo "There is no package called $1 that can be installed" >&2; exit 4
    fi
    sim=$(apt-get -s -y -o Debug::NoLocking=1 install -- "$1" 2>&1) || { echo "apt cannot install $1: $(echo "$sim" | tail -n 2 | tr '\n' ' ')" >&2; exit 4; }
    if echo "$sim" | grep -q '^Remv '; then
        echo "Installing $1 would remove other packages, so it was not started" >&2; exit 4
    fi
}

check_remove() {
    st=$(dpkg-query -W -f='${db:Status-Status}' -- "$1" 2>/dev/null || true)
    [ "$st" = "installed" ] || { echo "$1 is not installed" >&2; exit 4; }
    sim=$(apt-get -s -y -o Debug::NoLocking=1 remove -- "$1" 2>&1) || { echo "apt cannot remove $1" >&2; exit 4; }
    for p in $(echo "$sim" | sed -n 's/^Remv \([^ ]*\).*/\1/p'); do
        p=${p%%:*}
        if echo "$p" | grep -Eq "$PROTECTED_RE"; then
            echo "Removing $1 would also remove $p, which this machine needs. Not started." >&2; exit 4
        fi
        ess=$(dpkg-query -W -f='${Essential}${Priority}' -- "$p" 2>/dev/null || true)
        case "$ess" in
            yes*|*required*) echo "Removing $1 would also remove $p, which is essential. Not started." >&2; exit 4 ;;
        esac
    done
}

case "${1:-}" in
  install)
    valid_name "${2:-}" || { echo "That is not a valid package name" >&2; exit 2; }
    [ "$#" -eq 2 ] || { echo "usage: $0 install NAME" >&2; exit 2; }
    check_install "$2"
    start_job "install $2" /usr/bin/apt-get -y \
      -o DPkg::Lock::Timeout=120 \
      -o Dpkg::Options::=--force-confdef \
      -o Dpkg::Options::=--force-confold \
      install -- "$2"
    ;;
  remove)
    valid_name "${2:-}" || { echo "That is not a valid package name" >&2; exit 2; }
    [ "$#" -eq 2 ] || { echo "usage: $0 remove NAME" >&2; exit 2; }
    check_remove "$2"
    start_job "remove $2" /usr/bin/apt-get -y \
      -o DPkg::Lock::Timeout=120 \
      -o Dpkg::Options::=--force-confdef \
      -o Dpkg::Options::=--force-confold \
      remove -- "$2"
    ;;
  update)
    start_job update /usr/bin/apt-get update --error-on=any
    ;;
  upgrade)
    start_job upgrade /usr/bin/apt-get -y \
      -o DPkg::Lock::Timeout=120 \
      -o Dpkg::Options::=--force-confdef \
      -o Dpkg::Options::=--force-confold \
      upgrade
    ;;
  *)
    echo "usage: $0 update|upgrade|install NAME|remove NAME" >&2
    exit 2
    ;;
esac
