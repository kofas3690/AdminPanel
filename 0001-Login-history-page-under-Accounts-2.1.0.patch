+  <h2>History</h2>
+  <div class="toolbar">
+    <input id="fuser" placeholder="Filter by user or address" maxlength="64" aria-label="Filter sign-ins">
+    <span id="okcount" class="muted"></span>
+  </div>
+  <div class="tbl-wrap"><table>
+    <thead><tr><th>User</th><th>Terminal</th><th>From</th><th>Signed in</th><th>Duration</th></tr></thead>
+    <tbody id="hist"></tbody>
+  </table></div>
+</section>
+
+<section id="tab-bad" hidden>
+  <div class="toolbar">
+    <label>Period <select id="rng"><option value="24h">Last 24 hours</option><option value="7d">Last 7 days</option><option value="30d">Last 30 days</option></select></label>
+    <span id="badcount" class="muted"></span>
+  </div>
+  <h2>By source address</h2>
+  <div class="tbl-wrap"><table>
+    <thead><tr><th>Address</th><th>Attempts</th><th>User names tried</th><th>Last attempt</th></tr></thead>
+    <tbody id="byip"></tbody>
+  </table></div>
+  <h2>Latest attempts</h2>
+  <div class="tbl-wrap"><table>
+    <thead><tr><th>Time</th><th>User name</th><th>Address</th></tr></thead>
+    <tbody id="recent"></tbody>
+  </table></div>
+  <p class="muted">Counts SSH password and key failures from the system journal. A long list from one address is
+  usually an automatic guessing run; the Firewall page can block it.</p>
+</section>
